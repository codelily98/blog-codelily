{
  "name": "codelily-workspace",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@codelily/code-lily",
    "build": "npm run build --workspace=@codelily/code-lily",
    "start": "npm run start --workspace=@codelily/code-lily",
    "typecheck": "tsc --noEmit -p apps/code-lily/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file-if-exists=apps/code-lily/.env.migrate.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=apps/code-lily/.env.local scripts/seed.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:server": "tsx scripts/e2e-server.ts",
    "db:maintain": "tsx --env-file-if-exists=apps/code-lily/.env.local scripts/maintenance.ts",
    "format": "prettier --write apps packages scripts tests playwright.config.ts",
    "local:setup": "node scripts/setup-local.mjs",
    "local:up": "docker compose --profile web up -d --build --wait",
    "local:down": "docker compose --profile web down",
    "verify:local": "tsx scripts/verify-local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@electric-sql/pglite": "0.5.14",
    "better-auth": "1.7.15",
    "kysely": "0.29.8",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite-socket": "0.2.17",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/tabulator-tables": "6.3.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
