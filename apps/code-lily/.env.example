# Copy to .env.local. Never commit secrets.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAILS=codelily98@gmail.com
# Empty DATABASE_URL enables development PGlite only. Production requires Postgres.
DATABASE_URL=
DB_POOL_MAX=5
TELEMETRY_SECRET=
INTERNAL_API_TOKEN=
# Cloudflare R2 S3 API endpoint, NOT the public CDN custom domain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
# Production: APP_URL/BETTER_AUTH_URL=https://blog.codelily.kr
# Google redirect: https://blog.codelily.kr/api/auth/callback/google
